def do_go(action, argv=None):
    """go 套餐域 key 轮换：go-rotate go {set|next|cooldown}"""
    argv = argv or []
    if action == "set":
        if len(argv) < 1:
            sys.exit("用法: go-rotate go set <name>")
        _go_set(load(), argv[0])
    elif action == "next":
        try:
            minutes = int(argv[0]) if argv else None
        except ValueError:
            sys.exit(f"非法 go 分钟值: {argv[0]}\n用法: go-rotate go next [分钟]")
        _go_next(load(), minutes)
    elif action == "cooldown":
        if len(argv) < 1:
            sys.exit("用法: go-rotate go cooldown <name> [分钟|clear]")
        _go_cooldown(load(), argv[0], argv[1:])
    else:
        print(GO_USAGE)
        if action is not None:
            sys.exit(1)


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return
    cmd = args[0]
    if cmd == "init":
        do_init()
        return
    if cmd == "uninstall":
        do_uninstall(force=("-y" in args or "--yes" in args))
        return
    if cmd == "check":
        # check 写各 key 健康状态/探测时间 → 持锁
        _with_lock(lambda: do_check(load(), args[1:]))
        return
    if cmd == "web":
        # web on/off 写配置 → 持锁；web（独立启动）不写配置不持锁
        if len(args) > 1 and args[1] in ("on", "off"):
            _with_lock(lambda: do_web(load(), args[1]))
        else:
            do_web(load(), args[1] if len(args) > 1 else None)
        return
    if cmd == "stats":
        do_stats()
        return
    if cmd == "go":
        sub = args[1] if len(args) > 1 else None
        # go 域写命令（set/next/cooldown 写 go-keys.json）走配置锁；无合法子命令只读打印用法
        if sub in ("set", "next", "cooldown"):
            _with_lock(lambda: do_go(sub, args[2:]))
        else:
            do_go(sub, args[2:])
        return
    if cmd == "gateway":
        sub = args[1] if len(args) > 1 else None
        # 写命令走配置锁（避免与插件并发写配置）：服务启停 + plan/token 写 gateway-config、网关域 set/next/cooldown 写 go-keys.json。
        # 只读（status/logs/plan 无参/token 无参）不锁。
        if sub in ("start", "stop", "restart", "set", "next", "cooldown"):
            _with_lock(lambda: do_gateway(sub, args[2:]))
        elif sub == "plan" and len(args) > 2:
            _with_lock(lambda: do_gateway(sub, args[2:]))
        elif sub == "token" and len(args) > 2 and args[2] in ("gen", "clear", "set"):
            _with_lock(lambda: do_gateway(sub, args[2:]))
        else:
            do_gateway(sub, args[2:])
        return
    if cmd in ("status", "list"):
        do_status(load())
    elif cmd == "set" and len(args) >= 2:
        _with_lock(lambda: do_set(load(), args[1]))
    elif cmd == "next":
        try:
            minutes = int(args[1]) if len(args) > 1 else None
        except ValueError:
            sys.exit(f"非法分钟值: {args[1]}\n用法: go-rotate next [minutes]")
        _with_lock(lambda: do_next(load(), minutes))
    elif cmd == "add" and len(args) >= 3:
        _with_lock(lambda: do_add(load(), args[1], args[2]))
    elif cmd == "cooldown" and len(args) >= 2:
        _with_lock(lambda: do_cooldown(load(), args[1], args[2:]))
    else:
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main()
