# 与 go-rotate.ts 插件一致的锁参数
LOCK_FILE = CONFIG_FILE + ".lock"
LOCK_TIMEOUT_MS = 5000      # 拿不到锁的等待上限
LOCK_STALE_MS = 15000       # 超过该 mtime 视为陈旧锁，可强制删除


def _with_lock(fn):
    """跨进程写锁（与插件 withLockSync 同机制：O_EXCL + 陈旧锁检测 + 超时降级）。
    所有写 go-keys.json 的路径都必须走这里，避免与插件 rotate 并发时互相覆盖/损坏。"""
    lock = LOCK_FILE
    os.makedirs(os.path.dirname(lock) or ".", exist_ok=True)
    deadline = time.time() + LOCK_TIMEOUT_MS / 1000
    while True:
        try:
            fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.write(fd, str(os.getpid()).encode())
            os.close(fd)
            break
        except FileExistsError:
            try:
                if time.time() - os.stat(lock).st_mtime > LOCK_STALE_MS / 1000:
                    os.unlink(lock)
                    continue
            except OSError:
                pass
            if time.time() >= deadline:
                print("⚠️  获取配置锁超时（>5s），跳过锁继续（与插件降级行为一致）")
                break
            time.sleep(0.05)
    try:
        return fn()
    finally:
        try:
            os.unlink(lock)
        except OSError:
            pass


def load() -> dict:
    if not os.path.exists(CONFIG_FILE):
        sys.exit(f"config not found: {CONFIG_FILE}")
    with open(CONFIG_FILE) as f:
        cfg = json.load(f)
    cfg.setdefault("provider_id", "opencode-go")
    cfg.setdefault("cooldown_minutes", DEFAULT_COOLDOWN_MIN)
    cfg.setdefault("current", "")
    cfg.setdefault("keys", [])
    return cfg


def save(cfg: dict):
    os.makedirs(DATA_DIR, exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2)
    os.replace(tmp, CONFIG_FILE)  # 原子写（与插件 atomicWrite 对齐）


def sync_auth(key: str):
    os.makedirs(os.path.dirname(AUTH_FILE), exist_ok=True)
    data = {}
    if os.path.exists(AUTH_FILE):
        with open(AUTH_FILE) as f:
            data = json.load(f)
    auth = data.get("opencode-go")
    if isinstance(auth, dict):
        auth["key"] = key
    else:
        data["opencode-go"] = {"type": "api", "key": key}
    with open(AUTH_FILE, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    os.chmod(AUTH_FILE, 0o600)


def fmt_until(iso: str) -> str:
    if not iso:
        return "available"
    try:
        t = datetime.fromisoformat(iso.replace("Z", "+00:00"))
        remain = t - datetime.now(timezone.utc)
        if remain.total_seconds() <= 0:
            return "available (expired)"
        mins = int(remain.total_seconds() // 60)
        return f"cooling, ~{mins}min left"
    except Exception:
        return f"cooling until={iso}"


