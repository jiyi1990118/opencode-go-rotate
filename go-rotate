                k["cooldown_until_go"] = None
                save(cfg)
                print(f'go key "{name}" 冷却已清除（恢复可用）')
                return
            try:
                mins = int(minutes) if minutes else k.get("cooldown_minutes") or cfg.get("cooldown_minutes", DEFAULT_COOLDOWN_MIN)
